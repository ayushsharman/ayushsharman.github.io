---
import { howIWork } from '../content/site';
---
<section id="how" class="section">
  <p class="label">// how_i_work</p>
  <ol class="hw">
    {howIWork.map((h, i) => <li><span class="mono n">0{i + 1}</span><h3>{h.claim}</h3><p>{h.proof}</p></li>)}
  </ol>
</section>
<style>
  .hw { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  li { padding: 34px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .n { font-size: 11px; color: var(--acc); }
  h3 { font-size: clamp(22px, 2.4vw, 30px); font-weight: 500; letter-spacing: -.02em; line-height: 1.15; margin-top: 14px; }
  p { color: var(--mute); margin-top: 12px; font-size: 15px; line-height: 1.55; max-width: 460px; }
  @media (max-width: 720px) { .hw { grid-template-columns: 1fr; } li { padding: 24px; } }
</style>
