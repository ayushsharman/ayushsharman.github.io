---
import { links } from '../content/site';
---
<div class="sx-panel" id="secrets-panel" hidden role="dialog" aria-label="secrets">
  <p class="label">// secrets</p>
  <ul data-secrets-list></ul>
  <button class="sx-close mono" type="button" data-secrets-close>close</button>
</div>
<p class="sx-toast mono" data-secrets-toast aria-live="polite"></p>
<div class="sx-finale" id="secrets-finale" hidden role="dialog" aria-modal="true" aria-label="you found everything">
  <p class="label">// all secrets found</p>
  <p class="sx-big">you found everything.<br />you'd make a decent FDE.</p>
  <p class="sx-row"><a class="sx-hi mono" href={`mailto:${links.email}`}>say hi &rarr;</a><button class="sx-close mono" type="button" data-finale-close>close</button></p>
</div>
<script>
  import { secrets, unlock } from '../lib/secrets';
  import { createKonami } from '../lib/konami';
  const s = secrets();
  const panel = document.getElementById('secrets-panel')!;
  const finale = document.getElementById('secrets-finale')!;
  const toast = document.querySelector<HTMLElement>('[data-secrets-toast]')!;
  const counters = () => document.querySelectorAll<HTMLElement>('[data-secrets-count]');
  const paint = () => {
    counters().forEach((c) => { c.textContent = `${s.count()}/${s.total()}`; });
    panel.querySelector('[data-secrets-list]')!.innerHTML = s.list
      .map((x) => (s.isFound(x.id) ? `<li class="found">${x.title}</li>` : `<li>??? <span>${x.hint}</span></li>`))
      .join('');
  };
  let toastTimer = 0;
  window.addEventListener('secret:unlocked', (e) => {
    const d = (e as CustomEvent).detail as { title: string; count: number; total: number };
    paint();
    toast.textContent = `> achievement unlocked: ${d.title} (${d.count}/${d.total})`;
    toast.classList.add('on');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('on'), 3000);
    if (d.count === d.total) window.setTimeout(openFinale, 900);
  });

  // The panel: focus moves in on open and back to the counter on close.
  const openers = () => [...document.querySelectorAll<HTMLButtonElement>('[data-secrets-open]')];
  let opener: HTMLElement | null = null;
  const setPanel = (open: boolean) => {
    panel.hidden = !open;
    openers().forEach((b) => b.setAttribute('aria-expanded', String(open)));
    if (open) { paint(); panel.querySelector<HTMLElement>('[data-secrets-close]')?.focus(); }
    else opener?.focus();
  };
  openers().forEach((b) => b.addEventListener('click', () => { opener = b; setPanel(panel.hidden === true); }));
  panel.querySelector('[data-secrets-close]')!.addEventListener('click', () => setPanel(false));

  // The finale: modal, with the page behind made inert, and focus restored where it was.
  let finaleReturn: HTMLElement | null = null;
  let inerted: HTMLElement[] = [];
  function openFinale() {
    finaleReturn = document.activeElement as HTMLElement | null;
    inerted = [...document.body.children].filter((c): c is HTMLElement => c instanceof HTMLElement && !c.contains(finale));
    inerted.forEach((c) => { c.inert = true; });
    finale.hidden = false;
    finale.querySelector<HTMLElement>('a')?.focus();
  }
  function closeFinale() {
    if (finale.hidden) return;
    finale.hidden = true;
    inerted.forEach((c) => { c.inert = false; });
    inerted = [];
    finaleReturn?.focus?.();
  }
  finale.querySelector('[data-finale-close]')!.addEventListener('click', closeFinale);

  const feed = createKonami(() => unlock('konami'));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { if (!panel.hidden) setPanel(false); closeFinale(); }
    feed(e.key);
  });
  paint();
</script>
<style>
  .sx-panel { position: fixed; top: 64px; right: var(--gutter); z-index: 60; width: min(320px, calc(100vw - 40px)); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-md); padding: 20px; }
  .sx-panel ul { list-style: none; padding: 0; display: grid; gap: 10px; font-size: 14px; }
  .sx-panel :global(li) { color: var(--mute); font-family: var(--font-mono); font-size: 13px; }
  .sx-panel :global(li span) { color: var(--mute); margin-left: 6px; font-style: italic; }
  .sx-panel :global(li.found) { color: var(--acc); }
  .sx-close { margin-top: 16px; font-size: 12px; color: var(--mute); background: none; border: 1px solid var(--line); padding: 6px 10px; border-radius: var(--radius-sm); cursor: pointer; }
  .sx-toast { position: fixed; left: var(--gutter); bottom: 24px; z-index: 60; margin: 0; font-size: 13px; color: var(--acc); background: var(--bg-deep); border: 1px solid var(--acc); padding: 10px 14px; border-radius: var(--radius-sm); opacity: 0; transform: translateY(8px); pointer-events: none; transition: opacity var(--dur-normal) var(--ease-standard), transform var(--dur-normal) var(--ease-standard); }
  .sx-toast.on { opacity: 1; transform: none; }
  .sx-finale { position: fixed; inset: 0; z-index: 95; display: grid; place-content: center; padding: var(--gutter); background: color-mix(in srgb, var(--bg-deep) 92%, transparent); text-align: left; }
  .sx-finale[hidden] { display: none; }
  .sx-big { font-size: clamp(32px, 5vw, 64px); font-weight: 500; letter-spacing: -.03em; line-height: 1.05; }
  .sx-row { display: flex; gap: 16px; align-items: center; margin-top: 28px; }
  .sx-hi { color: var(--bg); background: var(--acc); padding: 10px 16px; border-radius: var(--radius-pill); text-decoration: none; font-size: 14px; }
  .sx-row .sx-close { margin-top: 0; }
</style>
