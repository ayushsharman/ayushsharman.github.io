---
import { work, alsoBuilt } from '../content/site';
---
<section id="work" class="section">
  <p class="label">// selected_work/</p>
  <h2 class="h2">Things that run without me<br />watching them.</h2>
  <ol class="wk">
    {work.map((w) => (
      <li>
        <a class="w" href={`/work/${w.slug}/`}>
          <span class="n mono">{w.n}</span>
          <span><span class="t">{w.title}</span><span class="d">{w.line}</span></span>
          <span class="meta mono">
            {w.trace.map((s) => <span class={s.startsWith('!') || s.startsWith('?') ? 'warn' : ''}>{s}</span>)}
            <span class="org">{w.org} &middot; {w.year}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
  <div class="also">
    <p class="label">// also_built</p>
    <ul>
      {alsoBuilt.map((a) => (
        <li>
          <button class="card" type="button" data-private>
            <span class="an">{a.name}</span>
            <span class="al">{a.line}</span>
            <span class="at mono">{a.tags.join(' \u00b7 ')}<span class="priv"> &middot; private repo</span></span>
            <span class="quip mono" aria-live="polite"></span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>
<script>
  import { privateQuip, PRIVATE_QUIPS } from '../lib/quips';
  document.querySelectorAll<HTMLButtonElement>('[data-private]').forEach((card) => {
    let clicks = 0;
    const quip = card.querySelector<HTMLElement>('.quip')!;
    card.addEventListener('click', () => {
      clicks += 1;
      quip.textContent = privateQuip(clicks);
      card.classList.remove('nope');
      void card.offsetWidth; // restart the shake on every click
      card.classList.add('nope');
      // The last line offers the way in: the next click goes to contact.
      if (clicks > PRIVATE_QUIPS.length) document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>
<style>
  .wk { list-style: none; padding: 0; margin-top: 44px; border-top: 1px solid var(--line); }
  .w { display: grid; grid-template-columns: 70px 1fr 260px; gap: 24px; padding: 30px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .n { color: var(--mute); }
  .t { display: block; font-size: 28px; font-weight: 500; letter-spacing: -.02em; transition: color var(--dur-normal) var(--ease-standard); }
  .w:hover .t, .w:focus-visible .t { color: var(--acc); }
  .d { display: block; color: var(--mute); margin-top: 8px; font-size: 15px; line-height: 1.5; max-width: 560px; }
  .meta { display: flex; flex-direction: column; font-size: 11px; color: var(--mute); line-height: 1.9; }
  .meta .warn { color: var(--warn); }
  .meta .org { color: var(--acc); margin-top: 4px; }
  .also { margin-top: 56px; }
  .also ul { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .also li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .card { all: unset; box-sizing: border-box; width: 100%; height: 100%; display: flex; flex-direction: column; gap: 8px; padding: 22px 24px; cursor: pointer; transition: background var(--dur-fast) var(--ease-standard); }
  .card:hover { background: var(--surface); }
  .card:focus-visible { outline: 2px solid var(--acc); outline-offset: -2px; }
  .quip { min-height: 1.4em; font-size: 13px; color: var(--hot); }
  .nope { animation: nope var(--dur-slow) var(--ease-standard); }
  @keyframes nope { 20% { transform: translateX(-6px); } 40% { transform: translateX(5px); } 60% { transform: translateX(-3px); } 80% { transform: translateX(2px); } }
  .an { font-size: 20px; font-weight: 500; letter-spacing: -.02em; }
  .al { color: var(--mute); font-size: 15px; line-height: 1.5; }
  .at { font-size: 11px; color: var(--acc); margin-top: 4px; }
  .priv { color: var(--mute); }
  @media (max-width: 720px) { .also ul { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .w { grid-template-columns: 40px 1fr; } .meta { grid-column: 2; } .t { font-size: 22px; } }
</style>
