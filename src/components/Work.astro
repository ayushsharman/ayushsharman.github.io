---
import { work, alsoBuilt } from '../content/site';
import '../styles/games.css';
---
<section id="work" class="section">
  <p class="label">// selected_work/</p>
  <h2 class="h2">Things that run without me<br />watching them.</h2>
  <ol class="wk">
    {work.map((w) => (
      <li>
        <a class="w" href={`/work/${w.slug}/`}>
          <span class="n mono">{w.n}</span>
          <span><span class="t">{w.title}</span><span class="d">{w.line}</span></span>
          <span class="meta mono">
            {w.trace.map((s) => <span class={s.startsWith('!') || s.startsWith('?') ? 'warn' : ''}>{s}</span>)}
            <span class="org">{w.org} &middot; {w.year}</span>
          </span>
        </a>
        {w.game && (
          <>
            <button class="play mono" type="button" data-play={w.game} aria-expanded="false" aria-controls={`game-${w.slug}`}>[ watch ]</button>
            <div class="panel" id={`game-${w.slug}`} hidden></div>
          </>
        )}
      </li>
    ))}
  </ol>
  <div class="also">
    <p class="label">// also_built</p>
    <ul>
      {alsoBuilt.map((a) => (
        <li>
          <button class="card" type="button" data-private>
            <span class="an">{a.name}</span>
            <span class="al">{a.line}</span>
            <span class="at mono">{a.tags.join(' \u00b7 ')}<span class="priv"> &middot; private repo</span></span>
            <span class="quip mono" aria-live="polite"></span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>
<script>
  // Simulations load only when someone presses watch, so they cost the home page nothing.
  const loaders = {
    reconcile: () => import('../lib/games/reconcile-sim').then((m) => m.mountReconcileSim),
    loop: () => import('../lib/games/loop-sim').then((m) => m.mountLoopSim),
    p0: () => import('../lib/games/p0-sim').then((m) => m.mountP0Sim),
    mrr: () => import('../lib/games/mrr-sim').then((m) => m.mountMrrSim),
  };
  const closers = new Map<HTMLButtonElement, () => void>();
  document.querySelectorAll<HTMLButtonElement>('[data-play]').forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute('aria-controls')!)!;
    let stop: (() => void) | null = null;
    // Stopping matters: a run left going would still unlock its secret for a scene nobody watched.
    const close = () => { stop?.(); stop = null; panel.hidden = true; panel.replaceChildren(); btn.setAttribute('aria-expanded', 'false'); btn.textContent = '[ watch ]'; };
    closers.set(btn, () => { if (!panel.hidden) close(); });
    btn.addEventListener('click', async () => {
      if (!panel.hidden) { close(); btn.focus(); return; }
      // Close any other open scene directly: clicking its toggle would move focus to that row.
      closers.forEach((c, other) => { if (other !== btn) c(); });
      btn.setAttribute('aria-expanded', 'true');
      btn.textContent = '[ close ]';
      panel.hidden = false;
      const mount = await loaders[btn.dataset.play as keyof typeof loaders]();
      if (!panel.hidden) stop = mount(panel);
      panel.querySelector<HTMLElement>('button')?.focus();
    });
    // On the row, not the panel: focus usually stays on the toggle, which sits outside the panel.
    btn.closest('li')!.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { close(); btn.focus(); } });
  });
  // A shareable link straight into a simulation: /?watch=reconcile
  const watch = new URLSearchParams(location.search).get('watch');
  const target = watch && document.querySelector<HTMLButtonElement>(`[data-play="${CSS.escape(watch)}"]`);
  if (target) {
    target.click();
    const li = target.closest('li');
    // Land on the row now, and again once the panel and late content above have settled.
    li?.scrollIntoView({ block: 'start', behavior: 'instant' });
    window.setTimeout(() => li?.scrollIntoView({ block: 'start', behavior: 'instant' }), 600);
  }
</script>
<script>
  import { quipFor } from '../lib/quips';
  document.querySelectorAll<HTMLButtonElement>('[data-private]').forEach((card) => {
    let clicks = 0;
    let last: string | null = null;
    const quip = card.querySelector<HTMLElement>('.quip')!;
    card.addEventListener('click', () => {
      clicks += 1;
      // Click four takes the way in that click three offered, then the cycle starts again.
      if (clicks > 3) {
        // No behavior option: the page's scroll-behavior decides, so reduced motion jumps instead.
        const contact = document.getElementById('contact');
        contact?.scrollIntoView();
        contact?.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
        clicks = 0; last = null; quip.textContent = '';
        return;
      }
      last = quipFor(clicks, last);
      quip.textContent = last;
      card.classList.remove('nope');
      void card.offsetWidth; // restart the shake on every click
      card.classList.add('nope');
    });
  });
</script>
<style>
  .wk { list-style: none; padding: 0; margin-top: 44px; border-top: 1px solid var(--line); }
  .wk > li { position: relative; }
  .play { position: absolute; right: 0; top: 30px; font-size: 12px; color: var(--acc); background: none; border: 1px solid var(--acc); padding: 6px 10px; border-radius: var(--radius-sm); cursor: pointer; transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard); }
  .play:hover, .play[aria-expanded="true"] { background: var(--acc); color: var(--bg); }
  .panel { padding-top: 6px; }
  .w { display: grid; grid-template-columns: 70px 1fr 260px 100px; gap: 24px; padding: 30px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .n { color: var(--mute); }
  .t { display: block; font-size: 28px; font-weight: 500; letter-spacing: -.02em; transition: color var(--dur-normal) var(--ease-standard); }
  .w:hover .t, .w:focus-visible .t { color: var(--acc); }
  .d { display: block; color: var(--mute); margin-top: 8px; font-size: 15px; line-height: 1.5; max-width: 560px; }
  .meta { display: flex; flex-direction: column; font-size: 11px; color: var(--mute); line-height: 1.9; }
  .meta .warn { color: var(--warn); }
  .meta .org { color: var(--acc); margin-top: 4px; }
  .also { margin-top: 56px; }
  .also ul { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .also li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .card { all: unset; box-sizing: border-box; width: 100%; height: 100%; display: flex; flex-direction: column; gap: 8px; padding: 22px 24px; cursor: pointer; transition: background var(--dur-fast) var(--ease-standard); }
  .card:hover { background: var(--surface); }
  .card:focus-visible { outline: 2px solid var(--acc); outline-offset: -2px; }
  .quip { min-height: 1.4em; font-size: 13px; color: var(--hot); }
  .nope { animation: nope var(--dur-slow) var(--ease-standard); }
  @keyframes nope { 20% { transform: translateX(-6px); } 40% { transform: translateX(5px); } 60% { transform: translateX(-3px); } 80% { transform: translateX(2px); } }
  .an { font-size: 20px; font-weight: 500; letter-spacing: -.02em; }
  .al { color: var(--mute); font-size: 15px; line-height: 1.5; }
  .at { font-size: 11px; color: var(--acc); margin-top: 4px; }
  .priv { color: var(--mute); }
  @media (max-width: 720px) { .also ul { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .w { grid-template-columns: 40px 1fr; } .meta { grid-column: 2; } .t { font-size: 22px; } .play { position: static; margin: 14px 0 20px 64px; } }
</style>
